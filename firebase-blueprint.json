{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "Root tenant document representing a cafe, restaurant, retail, or service business.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "businessCode": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "businessType": { "type": "string", "enum": ["restaurant", "cafe", "retail", "services"] },
        "plan": { "type": "string", "enum": ["daily", "standard", "premium"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "pending", "expired"] },
        "subscriptionRef": { "type": "string", "maxLength": 80 },
        "planDaysLeft": { "type": "number" },
        "subscriptionExpiresAt": { "type": "string", "format": "date-time" },
        "khqrAccountId": { "type": "string", "maxLength": 64 },
        "khqrAccountType": { "type": "string", "enum": ["individual", "merchant"] },
        "khqrMerchantName": { "type": "string", "maxLength": 64 },
        "khqrCity": { "type": "string", "maxLength": 48 },
        "khqrDefaultCurrency": { "type": "string", "enum": ["USD", "KHR"] },
        "ownerPermissions": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 30
        },
        "tenantStatus": { "type": "string", "enum": ["active", "suspended"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "name", "businessCode", "plan", "createdAt", "updatedAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Store branch configuration including exchange rate, tax, Bakong KHQR, and POS settings.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "exchangeRate": { "type": "number" },
        "vatPercent": { "type": "number" },
        "serviceChargePercent": { "type": "number" },
        "rielRounding": { "type": "number" },
        "simpleMode": { "type": "boolean" },
        "reservationsEnabled": { "type": "boolean" },
        "qrMode": { "type": "string", "enum": ["review", "auto"] },
        "khqrBakongId": { "type": "string", "maxLength": 64 },
        "khqrAccountName": { "type": "string", "maxLength": 64 },
        "khqrAccountType": { "type": "string", "enum": ["individual", "merchant"] },
        "khqrMerchantId": { "type": "string", "maxLength": 48 },
        "khqrAcquiringBank": { "type": "string", "maxLength": 64 },
        "khqrCity": { "type": "string", "maxLength": 48 },
        "khqrDefaultCurrency": { "type": "string", "enum": ["USD", "KHR"] },
        "khqrMcc": { "type": "string", "maxLength": 8 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 48 },
        "vattin": { "type": "string", "maxLength": 48 },
        "invoiceTemplate": { "$ref": "InvoiceTemplate" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "name", "code", "exchangeRate", "vatPercent", "updatedAt"]
    },
    "InvoiceTemplate": {
      "title": "InvoiceTemplate",
      "description": "Per-tenant branch invoice and receipt template configuration.",
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["thermal_80mm", "compact_58mm", "modern_bilingual", "a4_tax_invoice"] },
        "accentColor": { "type": "string", "enum": ["emerald", "slate", "amber", "crimson"] },
        "headerTitle": { "type": "string", "maxLength": 80 },
        "invoicePrefix": { "type": "string", "maxLength": 16 },
        "showLogoBadge": { "type": "boolean" },
        "logoText": { "type": "string", "maxLength": 12 },
        "logoIcon": {
          "type": "string",
          "enum": ["monogram", "store", "coffee", "utensils", "sparkles", "shopping_bag", "scissors", "building"]
        },
        "logoImageUrl": { "type": "string", "maxLength": 45000 },
        "showAddress": { "type": "boolean" },
        "showPhone": { "type": "boolean" },
        "showVattin": { "type": "boolean" },
        "showCashier": { "type": "boolean" },
        "showKhmerItemNames": { "type": "boolean" },
        "showItemNotes": { "type": "boolean" },
        "showVatBreakdown": { "type": "boolean" },
        "showExchangeRate": { "type": "boolean" },
        "qrFooterMode": { "type": "string", "enum": ["loyalty_ebill", "bakong_khqr", "none"] },
        "footerNote": { "type": "string", "maxLength": 180 },
        "buyerSignatureLabel": { "type": "string", "maxLength": 48 },
        "sellerSignatureLabel": { "type": "string", "maxLength": 48 }
      },
      "required": ["style", "accentColor", "headerTitle", "invoicePrefix"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Product or service item sold on the POS catalog with bilingual names, pricing, and image.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "itemType": { "type": "string", "enum": ["product", "service"] },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nameKh": { "type": "string", "maxLength": 120 },
        "nameVi": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "priceUsd": { "type": "number" },
        "station": { "type": "string", "enum": ["kitchen", "bar"] },
        "imageUrl": { "type": "string", "maxLength": 65000 },
        "isBestSeller": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "nameEn", "category", "priceUsd", "station", "active", "updatedAt"]
    },
    "PosTable": {
      "title": "PosTable",
      "description": "Floor plan table or takeaway slot.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "area": { "type": "string", "minLength": 1, "maxLength": 64 },
        "seats": { "type": "number" },
        "status": { "type": "string", "enum": ["free", "occupied", "ready"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "name", "area", "seats", "status", "updatedAt"]
    },
    "PosOrder": {
      "title": "PosOrder",
      "description": "Dine-in, takeaway, delivery, or QR order ticket.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderNumber": { "type": "number" },
        "tableId": { "type": "string", "maxLength": 128 },
        "channel": { "type": "string", "enum": ["dine_in", "take_away", "grab", "foodpanda", "qr_table", "qr_counter", "group"] },
        "status": { "type": "string", "enum": ["open", "sent", "cooking", "ready", "served", "paid", "voided"] },
        "totalUsd": { "type": "number" },
        "totalKhr": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "orderNumber", "channel", "status", "totalUsd", "totalKhr", "createdAt", "updatedAt"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Cash drawer shift record with USD and KHR reconciliation.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cashierName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "openingUsd": { "type": "number" },
        "openingKhr": { "type": "number" },
        "countedUsd": { "type": "number" },
        "countedKhr": { "type": "number" },
        "openedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "cashierName", "status", "openingUsd", "openingKhr", "openedAt", "updatedAt"]
    },
    "Ingredient": {
      "title": "Ingredient",
      "description": "Inventory stock item with weighted average cost and minimum threshold.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nameKh": { "type": "string", "maxLength": 120 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 24 },
        "onHand": { "type": "number" },
        "minLevel": { "type": "number" },
        "avgCostUsd": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "nameEn", "unit", "onHand", "minLevel", "avgCostUsd", "updatedAt"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Table booking with optional deposit.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "guestName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dateTime": { "type": "string", "minLength": 1, "maxLength": 40 },
        "guests": { "type": "number" },
        "depositUsd": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "seated", "cancelled", "no_show"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "guestName", "dateTime", "guests", "depositUsd", "status", "createdAt", "updatedAt"]
    },
    "VatInvoice": {
      "title": "VatInvoice",
      "description": "Cambodia GDT VAT invoice or credit note record.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "invoiceNo": { "type": "string", "minLength": 1, "maxLength": 64 },
        "invoiceType": { "type": "string", "enum": ["commercial", "tax", "credit_note"] },
        "exclVatUsd": { "type": "number" },
        "vatUsd": { "type": "number" },
        "totalUsd": { "type": "number" },
        "totalKhr": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "invoiceNo", "invoiceType", "exclVatUsd", "vatUsd", "totalUsd", "totalKhr", "createdAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private user PII profile isolated under users/{userId}/private/info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational audit event for discounts, voids, refunds, and drawer variances.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "branchId", "actorName", "action", "detail", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Platform Super Admin account with full global grant permission across all users, tenant owners, and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "updatedAt"]
    },
    "StaffMemberDoc": {
      "title": "StaffMemberDoc",
      "description": "Tenant staff member with role tier, 4-digit PIN, and explicit granted permission keys.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "username": { "type": "string", "minLength": 1, "maxLength": 64 },
        "roleLabel": { "type": "string", "minLength": 1, "maxLength": 64 },
        "role": { "type": "string", "enum": ["admin", "owner", "manager", "cashier", "waiter", "kitchen", "runner"] },
        "pin": { "type": "string", "minLength": 1, "maxLength": 8 },
        "active": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "permissions": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 30
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "name", "username", "role", "active", "updatedAt"]
    },
    "PlatformConfig": {
      "title": "PlatformConfig",
      "description": "Global platform configuration controlled exclusively by Super Admin (e.g. disabling all demo user accounts).",
      "type": "object",
      "properties": {
        "demoUsersDisabled": { "type": "boolean" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["demoUsersDisabled", "updatedAt"]
    }
  },
  "firestore": {
    "/platform/config": {
      "schema": { "$ref": "PlatformConfig" },
      "description": "Global platform flags managed by Super Admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "AdminUser" },
      "description": "Platform Super Admin registry."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "UserPrivateProfile" },
      "description": "Isolated PII profile for authenticated shop owner."
    },
    "/shops/{shopId}": {
      "schema": { "$ref": "Shop" },
      "description": "Shop root document owned by authenticated user."
    },
    "/shops/{shopId}/branches/{branchId}": {
      "schema": { "$ref": "Branch" },
      "description": "Branches belonging to a shop."
    },
    "/shops/{shopId}/staff/{staffId}": {
      "schema": { "$ref": "StaffMemberDoc" },
      "description": "Staff accounts and RBAC permission grants per shop."
    },
    "/shops/{shopId}/menuItems/{itemId}": {
      "schema": { "$ref": "MenuItem" },
      "description": "Menu dishes and drinks per shop."
    },
    "/shops/{shopId}/tables/{tableId}": {
      "schema": { "$ref": "PosTable" },
      "description": "Floor plan tables per branch."
    },
    "/shops/{shopId}/orders/{orderId}": {
      "schema": { "$ref": "PosOrder" },
      "description": "Active and completed POS orders."
    },
    "/shops/{shopId}/shifts/{shiftId}": {
      "schema": { "$ref": "Shift" },
      "description": "Cash drawer shifts."
    },
    "/shops/{shopId}/ingredients/{ingredientId}": {
      "schema": { "$ref": "Ingredient" },
      "description": "Inventory ingredients."
    },
    "/shops/{shopId}/reservations/{reservationId}": {
      "schema": { "$ref": "Reservation" },
      "description": "Table bookings and deposits."
    },
    "/shops/{shopId}/invoices/{invoiceId}": {
      "schema": { "$ref": "VatInvoice" },
      "description": "Issued VAT invoices."
    },
    "/shops/{shopId}/auditLogs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Append-only POS audit events."
    }
  }
}
