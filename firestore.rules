rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        || (isVerified() && request.auth.token.email == 'samchanpanha2021@gmail.com');
    }

    function isShopOwner(shopId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    function isOwnerOrAdmin(shopId) {
      return isShopOwner(shopId) || isAdmin();
    }

    function isValidPermissionList(list) {
      return list is list
        && list.size() <= 30
        && (list.size() == 0 || list[0] is string);
    }

    function isValidAdminUser(data, adminId) {
      return data.keys().hasAll(['uid', 'role', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'updatedAt'])
        && data.uid is string && data.uid == adminId
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.role == 'admin'
        && data.updatedAt == request.time;
    }

    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.updatedAt == request.time;
    }

    function isValidShop(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'businessCode', 'plan', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'businessCode', 'businessType', 'plan', 'subscriptionStatus', 'subscriptionRef', 'planDaysLeft', 'subscriptionExpiresAt', 'khqrAccountId', 'khqrAccountType', 'khqrMerchantName', 'khqrCity', 'khqrDefaultCurrency', 'ownerPermissions', 'tenantStatus', 'isDemo', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.businessCode is string && data.businessCode.size() >= 2 && data.businessCode.size() <= 32
        && data.businessCode.matches('^[A-Za-z0-9_\\-]+$')
        && (!('businessType' in data) || data.businessType in ['restaurant', 'cafe', 'retail', 'services'])
        && data.plan in ['daily', 'standard', 'premium']
        && (!('subscriptionStatus' in data) || data.subscriptionStatus in ['active', 'pending', 'expired'])
        && (!('subscriptionRef' in data) || (data.subscriptionRef is string && data.subscriptionRef.size() <= 80))
        && (!('planDaysLeft' in data) || (data.planDaysLeft is number && data.planDaysLeft >= 0 && data.planDaysLeft <= 3650))
        && (!('subscriptionExpiresAt' in data) || (data.subscriptionExpiresAt is string && data.subscriptionExpiresAt.size() <= 64))
        && (!('khqrAccountId' in data) || (data.khqrAccountId is string && data.khqrAccountId.size() <= 64))
        && (!('khqrAccountType' in data) || data.khqrAccountType in ['individual', 'merchant'])
        && (!('khqrMerchantName' in data) || (data.khqrMerchantName is string && data.khqrMerchantName.size() <= 64))
        && (!('khqrCity' in data) || (data.khqrCity is string && data.khqrCity.size() <= 48))
        && (!('khqrDefaultCurrency' in data) || data.khqrDefaultCurrency in ['USD', 'KHR'])
        && (!('ownerPermissions' in data) || isValidPermissionList(data.ownerPermissions))
        && (!('tenantStatus' in data) || data.tenantStatus in ['active', 'suspended'])
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'username', 'role', 'active', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'username', 'roleLabel', 'role', 'pin', 'active', 'isDemo', 'permissions', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 64
        && (!('roleLabel' in data) || (data.roleLabel is string && data.roleLabel.size() <= 64))
        && data.role in ['admin', 'owner', 'manager', 'cashier', 'waiter', 'kitchen', 'runner']
        && (!('pin' in data) || (data.pin is string && data.pin.size() >= 1 && data.pin.size() <= 8))
        && data.active is bool
        && (!('isDemo' in data) || data.isDemo is bool)
        && (!('permissions' in data) || isValidPermissionList(data.permissions))
        && data.updatedAt == request.time;
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['demoUsersDisabled', 'updatedAt'])
        && data.keys().hasOnly(['demoUsersDisabled', 'updatedByUid', 'updatedAt'])
        && data.demoUsersDisabled is bool
        && (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid.size() <= 128 && data.updatedByUid == request.auth.uid))
        && data.updatedAt == request.time;
    }

    function isValidInvoiceTemplate(tpl) {
      return tpl is map
        && tpl.keys().hasAll(['style', 'accentColor', 'headerTitle', 'invoicePrefix'])
        && tpl.keys().hasOnly(['style', 'accentColor', 'headerTitle', 'invoicePrefix', 'showLogoBadge', 'logoText', 'logoIcon', 'logoImageUrl', 'showAddress', 'showPhone', 'showVattin', 'showCashier', 'showKhmerItemNames', 'showItemNotes', 'showVatBreakdown', 'showExchangeRate', 'qrFooterMode', 'footerNote', 'buyerSignatureLabel', 'sellerSignatureLabel'])
        && tpl.style in ['thermal_80mm', 'compact_58mm', 'modern_bilingual', 'a4_tax_invoice']
        && tpl.accentColor in ['emerald', 'slate', 'amber', 'crimson']
        && tpl.headerTitle is string && tpl.headerTitle.size() >= 1 && tpl.headerTitle.size() <= 80
        && tpl.invoicePrefix is string && tpl.invoicePrefix.size() >= 1 && tpl.invoicePrefix.size() <= 16
        && (!('showLogoBadge' in tpl) || tpl.showLogoBadge is bool)
        && (!('logoText' in tpl) || (tpl.logoText is string && tpl.logoText.size() <= 12))
        && (!('logoIcon' in tpl) || tpl.logoIcon in ['monogram', 'store', 'coffee', 'utensils', 'sparkles', 'shopping_bag', 'scissors', 'building'])
        && (!('logoImageUrl' in tpl) || (tpl.logoImageUrl is string && tpl.logoImageUrl.size() <= 45000))
        && (!('showAddress' in tpl) || tpl.showAddress is bool)
        && (!('showPhone' in tpl) || tpl.showPhone is bool)
        && (!('showVattin' in tpl) || tpl.showVattin is bool)
        && (!('showCashier' in tpl) || tpl.showCashier is bool)
        && (!('showKhmerItemNames' in tpl) || tpl.showKhmerItemNames is bool)
        && (!('showItemNotes' in tpl) || tpl.showItemNotes is bool)
        && (!('showVatBreakdown' in tpl) || tpl.showVatBreakdown is bool)
        && (!('showExchangeRate' in tpl) || tpl.showExchangeRate is bool)
        && (!('qrFooterMode' in tpl) || tpl.qrFooterMode in ['loyalty_ebill', 'bakong_khqr', 'none'])
        && (!('footerNote' in tpl) || (tpl.footerNote is string && tpl.footerNote.size() <= 180))
        && (!('buyerSignatureLabel' in tpl) || (tpl.buyerSignatureLabel is string && tpl.buyerSignatureLabel.size() <= 48))
        && (!('sellerSignatureLabel' in tpl) || (tpl.sellerSignatureLabel is string && tpl.sellerSignatureLabel.size() <= 48));
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'code', 'exchangeRate', 'vatPercent', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'code', 'address', 'phone', 'vattin', 'exchangeRate', 'vatPercent', 'serviceChargePercent', 'rielRounding', 'simpleMode', 'reservationsEnabled', 'qrMode', 'khqrBakongId', 'khqrAccountName', 'khqrAccountType', 'khqrMerchantId', 'khqrAcquiringBank', 'khqrCity', 'khqrDefaultCurrency', 'khqrMcc', 'invoiceTemplate', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 48))
        && (!('vattin' in data) || (data.vattin is string && data.vattin.size() <= 48))
        && data.exchangeRate is number && data.exchangeRate > 0 && data.exchangeRate <= 100000
        && data.vatPercent is number && data.vatPercent >= 0 && data.vatPercent <= 50
        && (!('serviceChargePercent' in data) || (data.serviceChargePercent is number && data.serviceChargePercent >= 0 && data.serviceChargePercent <= 50))
        && (!('rielRounding' in data) || (data.rielRounding is number && data.rielRounding >= 1 && data.rielRounding <= 10000))
        && (!('simpleMode' in data) || data.simpleMode is bool)
        && (!('reservationsEnabled' in data) || data.reservationsEnabled is bool)
        && (!('qrMode' in data) || data.qrMode in ['review', 'auto'])
        && (!('khqrBakongId' in data) || (data.khqrBakongId is string && data.khqrBakongId.size() <= 64))
        && (!('khqrAccountName' in data) || (data.khqrAccountName is string && data.khqrAccountName.size() <= 64))
        && (!('khqrAccountType' in data) || data.khqrAccountType in ['individual', 'merchant'])
        && (!('khqrMerchantId' in data) || (data.khqrMerchantId is string && data.khqrMerchantId.size() <= 48))
        && (!('khqrAcquiringBank' in data) || (data.khqrAcquiringBank is string && data.khqrAcquiringBank.size() <= 64))
        && (!('khqrCity' in data) || (data.khqrCity is string && data.khqrCity.size() <= 48))
        && (!('khqrDefaultCurrency' in data) || data.khqrDefaultCurrency in ['USD', 'KHR'])
        && (!('khqrMcc' in data) || (data.khqrMcc is string && data.khqrMcc.size() <= 8))
        && (!('invoiceTemplate' in data) || isValidInvoiceTemplate(data.invoiceTemplate))
        && data.updatedAt == request.time;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'nameEn', 'category', 'priceUsd', 'station', 'active', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'itemType', 'nameEn', 'nameKh', 'nameVi', 'category', 'priceUsd', 'station', 'imageUrl', 'isBestSeller', 'isNew', 'active', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && (!('itemType' in data) || data.itemType in ['product', 'service'])
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && (!('nameKh' in data) || (data.nameKh is string && data.nameKh.size() <= 120))
        && (!('nameVi' in data) || (data.nameVi is string && data.nameVi.size() <= 120))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.priceUsd is number && data.priceUsd >= 0 && data.priceUsd <= 100000
        && data.station in ['kitchen', 'bar']
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 65000))
        && (!('isBestSeller' in data) || data.isBestSeller is bool)
        && (!('isNew' in data) || data.isNew is bool)
        && data.active is bool
        && data.updatedAt == request.time;
    }

    function isValidPosTable(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'name', 'area', 'seats', 'status', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'name', 'area', 'seats', 'status', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 48
        && data.area is string && data.area.size() >= 1 && data.area.size() <= 64
        && data.seats is number && data.seats >= 1 && data.seats <= 100
        && data.status in ['free', 'occupied', 'ready']
        && data.updatedAt == request.time;
    }

    function isValidPosOrder(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'orderNumber', 'channel', 'status', 'totalUsd', 'totalKhr', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'orderNumber', 'tableId', 'channel', 'status', 'totalUsd', 'totalKhr', 'paymentMethod', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && data.orderNumber is number && data.orderNumber >= 1 && data.orderNumber <= 1000000
        && (!('tableId' in data) || (data.tableId is string && data.tableId.size() <= 128))
        && data.channel in ['dine_in', 'take_away', 'grab', 'foodpanda', 'qr_table', 'qr_counter', 'group']
        && data.status in ['open', 'sent', 'cooking', 'ready', 'served', 'paid', 'voided']
        && data.totalUsd is number && data.totalUsd >= 0 && data.totalUsd <= 1000000
        && data.totalKhr is number && data.totalKhr >= 0 && data.totalKhr <= 5000000000
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidShift(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'cashierName', 'status', 'openingUsd', 'openingKhr', 'openedAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'cashierName', 'status', 'openingUsd', 'openingKhr', 'countedUsd', 'countedKhr', 'openedAt', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 80
        && data.status in ['open', 'closed']
        && data.openingUsd is number && data.openingUsd >= 0 && data.openingUsd <= 1000000
        && data.openingKhr is number && data.openingKhr >= 0 && data.openingKhr <= 5000000000
        && (!('countedUsd' in data) || (data.countedUsd is number && data.countedUsd >= 0 && data.countedUsd <= 1000000))
        && (!('countedKhr' in data) || (data.countedKhr is number && data.countedKhr >= 0 && data.countedKhr <= 5000000000))
        && data.openedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidIngredient(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'nameEn', 'unit', 'onHand', 'minLevel', 'avgCostUsd', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'nameEn', 'nameKh', 'unit', 'onHand', 'minLevel', 'avgCostUsd', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && (!('nameKh' in data) || (data.nameKh is string && data.nameKh.size() <= 120))
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 24
        && data.onHand is number && data.onHand >= 0 && data.onHand <= 10000000
        && data.minLevel is number && data.minLevel >= 0 && data.minLevel <= 10000000
        && data.avgCostUsd is number && data.avgCostUsd >= 0 && data.avgCostUsd <= 100000
        && data.updatedAt == request.time;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'guestName', 'dateTime', 'guests', 'depositUsd', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'guestName', 'dateTime', 'guests', 'depositUsd', 'status', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 80
        && data.dateTime is string && data.dateTime.size() >= 1 && data.dateTime.size() <= 40
        && data.guests is number && data.guests >= 1 && data.guests <= 200
        && data.depositUsd is number && data.depositUsd >= 0 && data.depositUsd <= 100000
        && data.status in ['pending', 'confirmed', 'seated', 'cancelled', 'no_show']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidVatInvoice(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'invoiceNo', 'invoiceType', 'exclVatUsd', 'vatUsd', 'totalUsd', 'totalKhr', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'invoiceNo', 'invoiceType', 'exclVatUsd', 'vatUsd', 'totalUsd', 'totalKhr', 'createdAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && data.invoiceNo is string && data.invoiceNo.size() >= 1 && data.invoiceNo.size() <= 64
        && data.invoiceType in ['commercial', 'tax', 'credit_note']
        && data.exclVatUsd is number && data.exclVatUsd >= 0 && data.exclVatUsd <= 1000000
        && data.vatUsd is number && data.vatUsd >= 0 && data.vatUsd <= 500000
        && data.totalUsd is number && data.totalUsd >= 0 && data.totalUsd <= 1500000
        && data.totalKhr is number && data.totalKhr >= 0 && data.totalKhr <= 7500000000
        && data.createdAt == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['ownerUid', 'branchId', 'actorName', 'action', 'detail', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'branchId', 'actorName', 'action', 'detail', 'createdAt'])
        && data.ownerUid is string && (data.ownerUid == request.auth.uid || isAdmin())
        && data.branchId is string && isValidId(data.branchId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 240
        && data.createdAt == request.time;
    }

    // Global Platform Config (Super Admin controlled)
    match /platform/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && configId == 'config';
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(configId) && configId == 'config' && isValidPlatformConfig(incoming());
      allow delete: if false;
    }

    // Super Admin Registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(adminId) && isValidAdminUser(incoming(), adminId);
      allow delete: if false;
    }

    // Isolated PII under users/{userId}/private/info
    match /users/{userId}/private/info {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUserPrivateProfile(incoming(), userId);
      allow update: if isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;
    }

    // Shops root tenant
    match /shops/{shopId} {
      allow get: if isSignedIn() && isValidId(shopId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(shopId)
        && isValidShop(incoming())
        && incoming().createdAt == request.time
        && (!('ownerPermissions' in incoming()) || isAdmin())
        && (!('tenantStatus' in incoming()) || incoming().tenantStatus == 'active' || isAdmin());
      allow update: if isVerified() && isValidId(shopId)
        && isValidShop(incoming())
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
            ? incoming().diff(existing()).affectedKeys().hasOnly(['name', 'businessType', 'plan', 'subscriptionStatus', 'subscriptionRef', 'planDaysLeft', 'subscriptionExpiresAt', 'khqrAccountId', 'khqrAccountType', 'khqrMerchantName', 'khqrCity', 'khqrDefaultCurrency', 'ownerPermissions', 'tenantStatus', 'isDemo', 'updatedAt'])
            : incoming().diff(existing()).affectedKeys().hasOnly(['name', 'businessType', 'plan', 'subscriptionStatus', 'subscriptionRef', 'planDaysLeft', 'subscriptionExpiresAt', 'khqrAccountId', 'khqrAccountType', 'khqrMerchantName', 'khqrCity', 'khqrDefaultCurrency', 'updatedAt'])
        );
      allow delete: if false;

      match /staff/{staffId} {
        allow get: if isValidId(shopId) && isValidId(staffId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(staffId)
          && isValidStaffMember(incoming())
          && isOwnerOrAdmin(shopId)
          && (isAdmin() || (incoming().role != 'admin' && incoming().role != 'owner'));
        allow update: if isVerified() && isValidId(shopId) && isValidId(staffId)
          && isValidStaffMember(incoming())
          && isOwnerOrAdmin(shopId)
          && incoming().ownerUid == existing().ownerUid
          && (isAdmin() || (existing().role != 'admin' && existing().role != 'owner' && incoming().role != 'admin' && incoming().role != 'owner'))
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'username', 'roleLabel', 'role', 'pin', 'active', 'isDemo', 'permissions', 'updatedAt']);
        allow delete: if isVerified() && isValidId(shopId) && isValidId(staffId)
          && isOwnerOrAdmin(shopId)
          && (isAdmin() || (existing().role != 'admin' && existing().role != 'owner'));
      }

      match /branches/{branchId} {
        allow get: if isValidId(shopId) && isValidId(branchId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(branchId)
          && isValidBranch(incoming())
          && isOwnerOrAdmin(shopId);
        allow update: if isVerified() && isValidId(shopId) && isValidId(branchId)
          && isValidBranch(incoming())
          && isOwnerOrAdmin(shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phone', 'vattin', 'exchangeRate', 'vatPercent', 'serviceChargePercent', 'rielRounding', 'simpleMode', 'reservationsEnabled', 'qrMode', 'khqrBakongId', 'khqrAccountName', 'khqrAccountType', 'khqrMerchantId', 'khqrAcquiringBank', 'khqrCity', 'khqrDefaultCurrency', 'khqrMcc', 'invoiceTemplate', 'updatedAt']);
        allow delete: if false;
      }

      match /menuItems/{itemId} {
        allow get: if isValidId(shopId) && isValidId(itemId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(itemId)
          && isValidMenuItem(incoming())
          && isOwnerOrAdmin(shopId);
        allow update: if isVerified() && isValidId(shopId) && isValidId(itemId)
          && isValidMenuItem(incoming())
          && isOwnerOrAdmin(shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().diff(existing()).affectedKeys().hasOnly(['itemType', 'nameEn', 'nameKh', 'nameVi', 'category', 'priceUsd', 'station', 'imageUrl', 'isBestSeller', 'isNew', 'active', 'updatedAt']);
        allow delete: if isVerified() && isValidId(shopId) && isValidId(itemId) && isOwnerOrAdmin(shopId);
      }

      match /tables/{tableId} {
        allow get: if isValidId(shopId) && isValidId(tableId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(tableId)
          && isValidPosTable(incoming())
          && isOwnerOrAdmin(shopId);
        allow update: if isVerified() && isValidId(shopId) && isValidId(tableId)
          && isValidPosTable(incoming())
          && isOwnerOrAdmin(shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'area', 'seats', 'status', 'updatedAt']);
        allow delete: if isVerified() && isValidId(shopId) && isValidId(tableId) && isOwnerOrAdmin(shopId);
      }

      match /orders/{orderId} {
        allow get: if isValidId(shopId) && isValidId(orderId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(orderId)
          && isValidPosOrder(incoming())
          && incoming().createdAt == request.time
          && isOwnerOrAdmin(shopId);
        allow update: if isVerified() && isValidId(shopId) && isValidId(orderId)
          && isValidPosOrder(incoming())
          && isOwnerOrAdmin(shopId)
          && !(existing().status in ['paid', 'voided'])
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['tableId', 'status', 'totalUsd', 'totalKhr', 'paymentMethod', 'updatedAt']);
        allow delete: if false;
      }

      match /shifts/{shiftId} {
        allow get: if isValidId(shopId) && isValidId(shiftId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(shiftId)
          && isValidShift(incoming())
          && incoming().openedAt == request.time
          && isOwnerOrAdmin(shopId);
        allow update: if isVerified() && isValidId(shopId) && isValidId(shiftId)
          && isValidShift(incoming())
          && isOwnerOrAdmin(shopId)
          && existing().status != 'closed'
          && incoming().ownerUid == existing().ownerUid
          && incoming().openedAt == existing().openedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'countedUsd', 'countedKhr', 'updatedAt']);
        allow delete: if false;
      }

      match /ingredients/{ingredientId} {
        allow get: if isValidId(shopId) && isValidId(ingredientId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(ingredientId)
          && isValidIngredient(incoming())
          && isOwnerOrAdmin(shopId);
        allow update: if isVerified() && isValidId(shopId) && isValidId(ingredientId)
          && isValidIngredient(incoming())
          && isOwnerOrAdmin(shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().diff(existing()).affectedKeys().hasOnly(['nameEn', 'nameKh', 'unit', 'onHand', 'minLevel', 'avgCostUsd', 'updatedAt']);
        allow delete: if false;
      }

      match /reservations/{reservationId} {
        allow get: if isValidId(shopId) && isValidId(reservationId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(reservationId)
          && isValidReservation(incoming())
          && incoming().createdAt == request.time
          && isOwnerOrAdmin(shopId);
        allow update: if isVerified() && isValidId(shopId) && isValidId(reservationId)
          && isValidReservation(incoming())
          && isOwnerOrAdmin(shopId)
          && !(existing().status in ['seated', 'cancelled', 'no_show'])
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['dateTime', 'guests', 'depositUsd', 'status', 'updatedAt']);
        allow delete: if false;
      }

      match /invoices/{invoiceId} {
        allow get: if isValidId(shopId) && isValidId(invoiceId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(invoiceId)
          && isValidVatInvoice(incoming())
          && isOwnerOrAdmin(shopId);
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow get: if isValidId(shopId) && isValidId(logId) && isOwnerOrAdmin(shopId);
        allow list: if isSignedIn() && isValidId(shopId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerified() && isValidId(shopId) && isValidId(logId)
          && isValidAuditLog(incoming())
          && isOwnerOrAdmin(shopId);
        allow update, delete: if false;
      }
    }
  }
}
